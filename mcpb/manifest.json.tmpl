{
  "manifest_version": "0.3",
  "name": "kenaz",
  "display_name": "Kenaz",
  "version": "@VERSION@",
  "description": "Kenaz, a Kameas AI product. Brings your organization's Kameas Fleet skills, team context and your Kenaz memory to chat in the Claude desktop app. Sends no usage telemetry. Includes the kenaz program. Requires a Kameas Fleet account. Claude is a trademark of Anthropic, PBC. Kenaz and Kameas are trademarks of Kameas AI, Inc. Kenaz is an independent product of Kameas AI, Inc. and is not affiliated with, endorsed or sponsored by Anthropic.",
  "long_description": "Chat reads only memory notes not tied to a project until you change \"Notes chat can read\" in this extension's settings. When your AI tool uses a note in a session, the note becomes part of that session and is sent to the tool's AI provider like the rest of the conversation. If you choose all, that can include notes from all your projects, not just the one you're working on.",
  "author": {
    "name": "Kameas AI, Inc.",
    "url": "https://kameas.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kameas-ai/kenaz-plugin.git"
  },
  "homepage": "https://kameas.ai",
  "license": "SEE LICENSE IN licenses/LICENSE",
  "documentation": "https://docs.kameas.ai/docs/kenaz-plugin/overview",
  "support": "https://docs.kameas.ai/docs/kenaz-plugin/troubleshooting",
  "icon": "icon.png",
  "server": {
    "type": "binary",
    "entry_point": "server/@EXE@",
    "mcp_config": {
      "command": "${__dirname}/server/@EXE@",
      "args": [
        "mcp"
      ],
      "env": {
        "KENAZ_ENV": "${user_config.fleet_env}",
        "KENAZ_ORG_HINT": "${user_config.org_hint}",
        "KENAZ_MEMORY_RECALL": "${user_config.memory_chat_recall}",
        "KENAZ_MCP_HOST": "claude-desktop"
      }
    }
  },
  "tools": [
    {
      "description": "Check a write approval",
      "name": "approval_status"
    },
    {
      "description": "List context files",
      "name": "context_list"
    },
    {
      "description": "Share a team note with the whole organization",
      "name": "context_promote"
    },
    {
      "description": "Read a context file",
      "name": "context_read"
    },
    {
      "description": "Read team context",
      "name": "context_pull"
    },
    {
      "description": "Search team context",
      "name": "context_search"
    },
    {
      "description": "Share a note with your team",
      "name": "context_share"
    },
    {
      "description": "Save a context file",
      "name": "context_write"
    },
    {
      "description": "Kameas Fleet status",
      "name": "fleet_status"
    },
    {
      "description": "Export memories",
      "name": "memory_export"
    },
    {
      "description": "Delete a memory",
      "name": "memory_forget"
    },
    {
      "description": "Delete all memories",
      "name": "memory_forget_all"
    },
    {
      "description": "Read memories",
      "name": "memory_get"
    },
    {
      "description": "List recent memories",
      "name": "memory_recent"
    },
    {
      "description": "Save a memory",
      "name": "memory_save"
    },
    {
      "description": "Search memories",
      "name": "memory_search"
    },
    {
      "description": "Memory timeline",
      "name": "memory_timeline"
    },
    {
      "description": "Memory sync settings",
      "name": "memory_sync_settings"
    },
    {
      "description": "Memory sync status",
      "name": "memory_sync_status"
    },
    {
      "description": "Edit a memory",
      "name": "memory_update"
    },
    {
      "description": "Install a shared skill",
      "name": "skills_install"
    },
    {
      "description": "Publish a skill",
      "name": "skills_publish"
    },
    {
      "description": "Search shared skills",
      "name": "skills_search"
    },
    {
      "description": "Uninstall a shared skill",
      "name": "skills_uninstall"
    },
    {
      "description": "List your teams and members",
      "name": "team_members"
    }
  ],
  "keywords": [
    "kameas",
    "fleet",
    "skills",
    "memory",
    "team context"
  ],
  "privacy_policies": [
    "https://kenaz.kameas.ai/privacy.html"
  ],
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "@PLATFORM@"
    ]
  },
  "user_config": {
    "fleet_env": {
      "type": "string",
      "title": "Kameas Fleet environment",
      "description": "Which Kameas Fleet environment to sign in to: prod, stage or dev.",
      "required": false,
      "default": "prod"
    },
    "org_hint": {
      "type": "string",
      "title": "Organization hint",
      "description": "Optional organization hint shown at sign-in.",
      "required": false,
      "default": ""
    },
    "memory_chat_recall": {
      "type": "string",
      "title": "Notes chat can read",
      "description": "Which memory notes chat can read: no-project for only notes not tied to a project, or all for notes from all your projects. Notes chat reads can go to the AI provider.",
      "required": false,
      "default": ""
    }
  }
}
