{
  "schema_version": 1,
  "features": [
    {
      "id": "otel-export",
      "description": "OTel export: session, model usage and tool outcomes received and acknowledged by Fleet; opt-out, retry/dedup and failure reporting"
    },
    {
      "id": "context",
      "description": "Context: team resolution, search, full read, explicit share, promotion, pagination/limits, forbidden cross-team access"
    },
    {
      "id": "private-memory",
      "description": "Private memory: save, recall, sync and forget, cross-host and two-device recall"
    },
    {
      "id": "skills",
      "description": "Skills: browse, install, host discovery and invocation, update, mandated materialization, publish, removal, collision/local edit"
    }
  ],
  "hosts": [
    {
      "id": "claude-code-cli",
      "name": "Claude Code CLI"
    },
    {
      "id": "codex-cli",
      "name": "Codex CLI"
    }
  ],
  "os_targets": [
    {
      "id": "macos-14-arm64",
      "name": "macOS 14+",
      "goos": "darwin",
      "goarch": "arm64"
    },
    {
      "id": "ubuntu-24.04-amd64",
      "name": "Ubuntu 24.04",
      "goos": "linux",
      "goarch": "amd64"
    },
    {
      "id": "windows-11-amd64",
      "name": "Windows 11",
      "goos": "windows",
      "goarch": "amd64"
    }
  ],
  "cells": [
    {
      "id": "otel-export/claude-code-cli/macos-14-arm64",
      "feature": "otel-export",
      "host": "claude-code-cli",
      "os": "macos-14-arm64",
      "required": true,
      "installed_journey": "journeys/otel-export.claude-code-cli.sh",
      "component_journey": {
        "package": "./app",
        "run": "^TestConformanceOTelJourney$/^claude-code$"
      }
