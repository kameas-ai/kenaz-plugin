variant: kenaz-dev
keychain service: kenaz-plugin
relay ports: [4318 47318 0]
env vars: [KENAZ_ENV CLAUDE_PLUGIN_OPTION_FLEET_ENV FLEET_PLUGIN_ENV]
mcp server: kenaz-dev
mcp host env var: KENAZ_MCP_HOST
official repo: 
approvals csrf cookie prod: kenaz_approvals_csrf
approvals csrf cookie stage: kenaz_stage_approvals_csrf
approvals csrf cookie dev: kenaz_dev_approvals_csrf
relay state darwin prod: /h/.kenaz/plugin/prod
relay state darwin stage: /h/.kenaz/plugin/stage
relay state darwin dev: /h/.kenaz/plugin/dev
fish profile darwin: /h/.config/fish/conf.d/kenaz-dev.fish
relay state linux prod: /h/.kenaz/plugin/prod
relay state linux stage: /h/.kenaz/plugin/stage
relay state linux dev: /h/.kenaz/plugin/dev
fish profile linux: /h/.config/fish/conf.d/kenaz-dev.fish
relay state windows prod: /h/.kenaz/plugin/prod
relay state windows stage: /h/.kenaz/plugin/stage
relay state windows dev: /h/.kenaz/plugin/dev
fish profile windows: /h/.config/fish/conf.d/kenaz-dev.fish
relay env =: dev
relay env KENAZ_ENV=dev: dev
relay env KENAZ_ENV=stage: error: The stage environment has been retired. Use dev. (KENAZ_ENV=stage)
relay env KENAZ_ENV=prod: error: kenaz-dev connects only to dev Fleet (KENAZ_ENV=prod)
relay env KENAZ_ENV=bogus: error: unknown Fleet env "bogus" from KENAZ_ENV (want dev)
path block: 
# >>> kenaz-dev PATH >>>
case ":$PATH:" in *':/d:'*) ;; *) export PATH='/d':"$PATH" ;; esac
# <<< kenaz-dev PATH <<<

path block bash: 
# >>> kenaz-dev PATH >>>
case ":$PATH:" in *':/d:'*) ;; *) export PATH='/d':"$PATH" ;; esac
# <<< kenaz-dev PATH <<<

path block fish: 
# >>> kenaz-dev PATH >>>
if not contains -- '/d' $PATH
    set -gx PATH '/d' $PATH
end
# <<< kenaz-dev PATH <<<

path profile files: profile profile.kenaz-dev-backup
path profile tmp suffix: .kenaz-dev-tmp
mcp implementation name: kenaz-dev
mcp implementation title: Kenaz (dev)
config dir: .kenaz/plugin
state root: .kenaz/plugin
consent store: .kenaz/plugin/dev/consent.json
KENAZ_HOME config dir: kh/plugin
KENAZ_HOME state root: kh/plugin
resolve flag="" ="" file="": dev default <nil>
resolve flag="dev" ="" file="": dev flag <nil>
resolve flag="prod" ="" file="":   kenaz-dev connects only to dev Fleet; use kenaz for prod
resolve flag="" KENAZ_ENV="stage" file="":   The stage environment has been retired. Use dev. (stage was selected by env)
resolve flag="" KENAZ_ENV="prod" file="":   kenaz-dev connects only to dev Fleet; use kenaz for prod (prod was selected by env)
resolve flag="" CLAUDE_PLUGIN_OPTION_FLEET_ENV="dev" file="": dev env <nil>
resolve flag="" FLEET_PLUGIN_ENV="dev" file="": dev env <nil>
resolve flag="" ="" file="stage":   The stage environment has been retired. Use dev. (stage was selected by config)
resolve flag="" ="" file="prod":   kenaz-dev connects only to dev Fleet; use kenaz for prod (prod was selected by config)
resolve flag="bogus" ="" file="":   unknown Fleet env "bogus" from flag (want dev)
resolve for cleanup flag="stage": stage flag <nil>
